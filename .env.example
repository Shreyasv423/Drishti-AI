# GEMINI_API_KEY: Required on the server for Gemini AI vision, assistant, and summarization routes.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE (Optional): Configure for cloud authentication, PostgreSQL persistence, and storage.
# Leave unset to run DRISHTI in local device-only mode with IndexedDB persistence.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# GOOGLE_MAPS_API_KEY (Optional): Server-side key for Google Routes API v2 and Places API (New).
# When unset, navigation uses GPS coordinates, compass bearing, and transparent offline/Nominatim fallback.
GOOGLE_MAPS_API_KEY="your-google-maps-server-api-key"
